{
  "permissions": {
    "deny": [
      "Read(.config/github.token)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Bash(git push origin main:*)",
      "Bash(git push --force:*)"
    ],
    "allow": [
      "Bash(npm test:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/deploy-gate.sh\""
          }
        ]
      }
    ]
  }
}
